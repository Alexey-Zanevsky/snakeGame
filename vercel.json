{
    "version": 2,
    "builds": [
        {
            "src": "api/index.js",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/auth/(.*)",
            "dest": "api/index.js"
        },
        {
            "src": "/api/(.*)",
            "dest": "api/index.js"
        },
        {
            "src": "/(.*\\.(?:js|css|json|png|jpg|jpeg|gif|svg|mp4|mp3|woff|woff2|eot|ttf|html))",
            "dest": "/$1"
        },
        {
            "src": "/.*",
            "dest": "/index.html"
        }
    ]
}